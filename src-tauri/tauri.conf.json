{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "retrovault",
  "version": "0.1.0",
  "identifier": "com.diaiain.retrovault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
     {
        "label": "main",
        "title": "RetroVault",
        "fullscreen": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
